    <profiles>
        <profile>
            <id>jenkins-build</id>
            <build>
                <plugins>
                    <!-- Plugin used to insert version and date into page footer -->
                    <plugin>
                        <groupId>com.google.code.maven-replacer-plugin</groupId>
                        <artifactId>replacer</artifactId>
                        <version>1.5.3</version>
                        <executions>
                            <execution>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>replace</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>${project.basedir}/src/main/webapp/index.jsp</include>
                                <include>${project.build.directory}/classes/fred.properties</include>
                            </includes>                             
                            <replacements>
                                <replacement>
                                    <token>PROJECT_VERSION</token>
                                    <value>${project.version}</value>
                                </replacement>
                                <replacement>
                                    <token>BUILD_DATE</token>
                                    <value>${build.display.date}</value>
                                </replacement>
                            </replacements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>        
    </profiles> 
