<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nz.cri.gns.fred</groupId>
        <artifactId>fred-top</artifactId>
        <version>3.3.23-SNAPSHOT</version>
    </parent>
    <groupId>nz.cri.gns</groupId>
    <artifactId>fred</artifactId>
    <packaging>war</packaging>
    <version>3.3.23-SNAPSHOT</version>
    <name>Fossil Record Electronic Database</name>
    <url>http://fred.org.nz</url>  
    <organization>
        <name>GNS Science Ltd</name>
        <url>http://www.gns.cri.nz</url>
    </organization>
    <description>FRED main webapp </description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Required to show the build date in the desired format -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>    
        <build.display.date>${maven.build.timestamp}</build.display.date>        
    </properties>     
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <showDeprecation>true</showDeprecation>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <tagNameFormat>RELEASE_@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <plugin>
                <!--testing--> 
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.15</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <plugin>
                <!--packaging-->   
                <artifactId>maven-war-plugin</artifactId>
                <version>3.2.3</version>
                <configuration>
                    <attachClasses>true</attachClasses>                            
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.7</version>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <!-- Exclude the FredStart class package from
                                 the jar file, so it doesn't get picked up
                                 and used by NPC -->
                            <classifier>classes</classifier>                            
                            <excludes>
                                <exclude>/nz/cri/gns/fred/*FredStart*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>            
        </plugins>
        <finalName>fred</finalName>
    </build>
