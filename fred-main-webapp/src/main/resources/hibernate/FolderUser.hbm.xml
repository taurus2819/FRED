<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FolderUser" 
    table="folder_user"
    schema="fr"
>

    <id
        name="fuId"
        type="int"
        column="fu_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.fu_seq</param>
                <param name="increment_size">1</param>
        </generator>
    </id>
    
    <property
        name="userRights"
        type="int"
        column="user_rights"
        length="3"
    />

    <!-- Associations -->

    <!-- bi-directional many-to-one association to Folder -->
    <many-to-one
        name="folder"
	    class="nz.cri.gns.fred.hibernate.Folder"
	    not-null="true"
	>
    	<column name="folder_id" />
	</many-to-one>

    <many-to-one
        name="user"
        class="nz.cri.gns.fred.hibernate.FrUserView"
        not-null="true"
	>
    	<column name="user_id" />
	</many-to-one>
		
</class>
</hibernate-mapping>