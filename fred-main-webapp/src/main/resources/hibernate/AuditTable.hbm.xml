<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.AuditTable" 
    table="audit_table"
    schema="fr"
>

    <id
        name="auditId"
        type="int"
        column="audit_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.audit_seq</param>
        </generator>
    </id>

    <property
        name="status"
        type="java.lang.String"
        column="status"
        not-null="true"
        length="16"
    />
    <property
        name="createdById"
        type="int"
        column="created_by_id"
        length="7"
    />
    <property
        name="createdDate"
        type="java.sql.Date"
        column="created_date"
    />
    <property
        name="submittedById"
        type="int"
        column="submitted_by_id"
        length="7"
    />
    <property
        name="submittedDate"
        type="java.sql.Date"
        column="submitted_date"
    />
    <property
        name="approvedById"
        type="int"
        column="approved_by_id"
        length="7"
    />
    <property
        name="approvedDate"
        type="java.sql.Date"
        column="approved_date"
    />
    <property
        name="workingComments"
        type="java.lang.String"
        column="working_comments"
        length="255"
    />
    <property
        name="curatorComments"
        type="java.lang.String"
        column="curator_comments"
        length="255"
    />
    <property
        name="sendMessage"
        type="java.lang.String"
        column="send_message"
        length="6"
    />
    <property
        name="confidentialFlag"
        type="boolean"
        column="confidential_flag"
    />
    <property
        name="confidPeriod"
        type="double"
        column="confid_period"
    />
    <property
        name="confidLapseDate"
        type="java.sql.Date"
        column="confid_lapse_date"
    />
    <property
        name="confidEmailFlag"
        type="boolean"
        column="confid_email_flag"
    />

    <property
        name="confidLapseEmail"
        type="java.lang.String"
        column="confid_lapse_email"
        length="32"
    />
    
    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to Folder -->
    <many-to-one
        name="folder"
        class="nz.cri.gns.fred.hibernate.Folder"
        not-null="true"
    >
        <column name="working_folder_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to DataOrigin -->
    <many-to-one
        name="dataOrigin"
        class="nz.cri.gns.fred.hibernate.DataOrigin"
        not-null="true"
    >
        <column name="data_origin_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to UserView -->
    <many-to-one
        name="createdBy"
        class="nz.cri.gns.fred.hibernate.UserView"
        not-null="false"
        insert="false"
        update="false"
    >
        <column name="created_by_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to UserView -->
    <many-to-one
        name="submittedBy"
        class="nz.cri.gns.fred.hibernate.UserView"
        not-null="false"
        insert="false"
        update="false"
    >
        <column name="submitted_by_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to UserView -->
    <many-to-one
        name="approvedBy"
        class="nz.cri.gns.fred.hibernate.UserView"
        not-null="false"
        insert="false"
        update="false"
    >
        <column name="approved_by_id" />
    </many-to-one>
    <!-- bi-directional one-to-many association to Sample -->
    <set
        name="samples"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="audit_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Sample"
        />
    </set>
    <!-- bi-directional one-to-many association to Record -->
    <set
        name="records"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="audit_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Record"
        />
    </set>
    <!-- bi-directional one-to-many association to Record -->
    <set
        name="recordByPalListAuditIds"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="pal_list_audit_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Record"
        />
    </set>
    <!-- bi-directional one-to-many association to Feature -->
    <set
        name="features"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="audit_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>
    <!-- bi-directional one-to-many association to AuditEdit -->
    <set
        name="auditEdits"
        lazy="true"
        inverse="true"
		cascade="all-delete-orphan"
    >
        <key>
            <column name="audit_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.AuditEdit"
        />
    </set>

    <!-- bi-directional many-to-many association to ConfidentialGroup via AuditConfid -->
    <set
        name="confidGroups"
        table="audit_confid"
		schema="fr"
        lazy="true"
        inverse="false"
		cascade="none"
    >
        <key>
            <column name="audit_id" />
        </key>
        <many-to-many 
			column="group_id"
            class="nz.cri.gns.fred.hibernate.ConfidentialGroup"
        />
    </set>
    
</class>
</hibernate-mapping>
