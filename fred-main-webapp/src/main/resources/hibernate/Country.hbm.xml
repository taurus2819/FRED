<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Country" 
    table="COUNTRY"
    schema="mis"
>

    <id
        name="countryCode"
        type="java.lang.String"
        column="COUNTRY_CODE"
        length="2"
    >
        <generator class="assigned" />
    </id>

   <property
        name="name"
        type="java.lang.String"
        column="COUNTRY_NAME"
        length="50"
    />
    <property
        name="dialCode"
        type="int"
        column="COUNTRY_DIAL_CODE"
    />
    
</class>
</hibernate-mapping>
