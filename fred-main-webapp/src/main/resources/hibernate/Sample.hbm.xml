        </many-to-one>
        <!-- bi-directional many-to-one association to Stage -->
        <many-to-one
            name="inferredStage"
            class="nz.cri.gns.fred.hibernate.Stage"
            not-null="true"
            cascade="none"
        >
            <column name="inferred_stage_id" />
        </many-to-one>



        <!-- bi-directional one-to-many association to SampleStageView -->
        <set
            name="sampleStageViews"
            lazy="true"
            inverse="true"
            cascade="none"
        >
            <key>
                <column not-null="true" name="sample_id" />
            </key>
            <one-to-many 
                class="nz.cri.gns.fred.hibernate.SampleStageView"
            />
        </set>

        <set
            name="squirrelAge"
            lazy="true"
            inverse="true"
            cascade="none"
        >
            <key>
                <column not-null="true" name="sample_id" />
            </key>
            <one-to-many 
                class="nz.cri.gns.fred.hibernate.SquirrelAgeView"
            />
        </set>


        <!-- bi-directional many-to-many association to MetaCat -->
        <set
            name="metaCats"
            lazy="true"
            cascade="none"
            table="SAMPLE_META"
        >
            <key>
                <column name="sample_id" />
            </key>
            <many-to-many
                class="nz.cri.gns.fred.hibernate.MetaCat"
            >
                <column name="META_ID" />
            </many-to-many>
        </set>
    
    </class>
</hibernate-mapping>
