<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FREDRecord" 
    table="record"
    schema="fr"
>

    <id
        name="recordId"
        type="int"
        column="record_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.record_seq</param>
                <param name="increment_size">1</param>
        </generator>
    </id>

    <!-- Associations -->
  
    <!-- bi-directional one-to-one association to Paleontology -->
    <one-to-one
        name="paleontology"
		class="nz.cri.gns.fred.hibernate.Paleontology"
		cascade="all"	
		outer-join="auto"
    />

    <!-- bi-directional one-to-one association to Adoption -->
    <one-to-one
        name="adoption"
        class="nz.cri.gns.fred.hibernate.Adoption"
        cascade="all"
		outer-join="auto"
    />
    <!-- bi-directional many-to-one association to Sample -->
    <many-to-one
        name="sample"
        class="nz.cri.gns.fred.hibernate.Sample"
        not-null="true"
    >
        <column name="sample_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="audit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
        cascade="all"
    >
        <column name="audit_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="palListAudit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
        cascade="all"
    >
        <column name="pal_list_audit_id" />
    </many-to-one>

    <!-- bi-directional many-to-many association to MetaCat -->
    <set
        name="metaCats"
        lazy="true"
		cascade="none"
        table="record_meta"
    >
        <key>
            <column name="record_id" />
        </key>
        <many-to-many
            class="nz.cri.gns.fred.hibernate.MetaCat"
        >
            <column name="meta_id" />
        </many-to-many>
    </set>

    <!-- bi-directional one-to-many association to RecordStageView -->
    <set
        name="recordStageViews"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column not-null="true" name="record_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.RecordStageView"
        />
    </set>
    
</class>
</hibernate-mapping>
