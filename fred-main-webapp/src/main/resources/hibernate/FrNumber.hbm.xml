<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FrNumber" 
    table="FR_NUMBER"
    schema="FR"
>

    <id
        name="frId"
        type="int"
        column="FR_ID"
    >
        <generator class="sequence">
                <param name="sequence">FR.FR_SEQ</param>
        </generator>
    </id>

    <property
        name="mapSheet"
        type="java.lang.String"
        column="MAP_SHEET"
        not-null="true"
        length="7"
    />
    <property
        name="serialNumber"
        type="int"
        column="SERIAL_NUMBER"
        not-null="true"
        length="5"
    />
    <property
        name="recollectionNumber"
        type="java.lang.String"
        column="RECOLLECTION_NUMBER"
        length="2"
    />
    <property
        name="frnumComments"
        type="java.lang.String"
        column="FRNUM_COMMENTS"
        length="255"
    />
    <property
        name="frNumber"
        type="java.lang.String"
        column="FR_NUMBER"
        length="15"
    />
    <property
        name="obsolete"
        type="java.lang.String"
        column="OBSOLETE"
        length="1"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to Sample -->
    <set
        name="samples"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="FR_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Sample"
        />
    </set>
    <!-- bi-directional one-to-many association to Sample (by Yard) -->
    <set
        name="samplesByYard"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="YARD_FR_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Sample"
        />
    </set>
    <!-- bi-directional one-to-many association to Feature -->
    <set
        name="features"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="FR_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>
    <!-- bi-directional one-to-many association to Feature (by Yard) -->
    <set
        name="featuresByYard"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="YARD_FR_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>

</class>
</hibernate-mapping>
