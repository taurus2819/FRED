<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.SampleStageView" 
    table="SAMPLE_STAGE_VIEW"
    schema="FR"
    mutable="false"
>

    <id
        name="id"
        type="java.lang.String"
        column="ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="type"
        type="java.lang.String"
        column="TYPE"
        length="12"
    />
    <property
        name="baseAge"
        type="java.lang.Double"
        column="BASE_AGE"
    />
    <property
        name="topAge"
        type="java.lang.Double"
        column="TOP_AGE"
    />

    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to Age -->
    <many-to-one
        name="sample"
        class="nz.cri.gns.fred.hibernate.Sample"
        not-null="false"
    >
        <column name="SAMPLE_ID" />
    </many-to-one>
    
    <!-- bi-directional many-to-one association to Age -->
    <many-to-one
        name="stage"
        class="nz.cri.gns.fred.hibernate.Stage"
        not-null="false"
    >
        <column name="STAGE_ID" />
    </many-to-one>
</class>
</hibernate-mapping>