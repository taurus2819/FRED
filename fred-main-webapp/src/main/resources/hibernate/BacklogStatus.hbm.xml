<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>

<class 
    name="nz.cri.gns.fred.hibernate.BacklogStatus" 
    table="backlog_status"
    schema="fr"
>

    <id
        name="objectId"
        type="int"
        column="objectid"
    >
        <generator class="assigned" />
    </id>

    <property
        name="mapNumber"
        type="java.lang.String"
        column="map_no"
        not-null="true"
        length="3"
    />
    <property
        name="mapName"
        type="java.lang.String"
        column="map_name"
        not-null="true"
        length="32"
    />
    <property
        name="status"
        type="java.lang.String"
        column="status"
        length="50"
    />
    <property
        name="masterfileId"
        type="int"
        column="masterfile_id"
        length="4"
    />
    <property
        name="localityCount"
        type="int"
        column="locality_count"
        length="4"
    />
    <property
        name="processingCount"
        type="int"
        column="processing_count"
        length="4"
    />
    <property
        name="completedCount"
        type="int"
        column="completed_count"
        length="4"
    />
        <property
        name="newCount"
        type="int"
        column="new_count"
        length="4"
    />

</class>
</hibernate-mapping>
