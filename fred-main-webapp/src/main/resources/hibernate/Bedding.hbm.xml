<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Bedding" 
    table="bedding"
    schema="fr"
>

    <id
        name="beddingId"
        type="int"
        column="bedding_id"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="name"
        not-null="true"
        length="32"
    />
    <property
        name="code"
        type="java.lang.String"
        column="code"
        not-null="true"
        unique="true"
        length="8"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to Sample -->
    <set
        name="samplesByPrimaryBeddingId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="primary_bedding_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Sample"
        />
    </set>
    <!-- bi-directional one-to-many association to Sample -->
    <set
        name="samplesBySecondaryBeddingId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="secondary_bedding_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Sample"
        />
    </set>

</class>
</hibernate-mapping>
