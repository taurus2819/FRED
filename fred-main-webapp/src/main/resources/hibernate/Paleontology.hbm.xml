<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

        http://boss.bekk.no/boss/middlegen/
        http://www.hibernate.org/
    -->

    <class 
        name="nz.cri.gns.fred.hibernate.Paleontology" 
        table="PALEONTOLOGY"
        schema="fr"
    >

        <id
            name="recordId"
            type="int"
            column="RECORD_ID"
        >
            <generator class="foreign">
                <param name="property">record</param>
            </generator>
        </id>

        <property
            name="identificationDate"
            type="java.sql.Date"
            column="IDENTIFICATION_DATE"
            length="7"
        />
        <property
            name="dateRounding"
            type="java.lang.String"
            column="DATE_ROUNDING"
            length="5"
        />
        <property
            name="stageComments"
            type="java.lang.String"
            column="STAGE_COMMENTS"
            length="255"
        />
        <property
            name="labNumber"
            type="java.lang.String"
            column="LAB_NUMBER"
            length="64"
        />
        <property
            name="collectionComments"
            type="java.lang.String"
            column="COLLECTION_COMMENTS"
            length="255"
        />

        <!-- Associations -->
  
        <!-- bi-directional one-to-one association to Record -->
        <one-to-one
            name="record"
            class="nz.cri.gns.fred.hibernate.Record"
            outer-join="auto"
            constrained="true"
            cascade="all"
        /> 
        <!-- bi-directional many-to-one association to LabSection -->
        <many-to-one
            name="labSection"
            class="nz.cri.gns.fred.hibernate.LabSection"
            not-null="true"
        >
            <column name="LAB_SECTION_ID" />
        </many-to-one>
        <!-- bi-directional one-to-many association to PalList -->
        <set
            name="listEntries"
            lazy="true"
            inverse="true"
            cascade="all-delete-orphan"
        >
            <key>
                <column name="RECORD_ID" />
            </key>
            <one-to-many 
                class="nz.cri.gns.fred.hibernate.PalList"
            />
        </set>
        <!-- bi-directional many-to-many association to Person via Identifier -->
        <set
            name="identifiers"
            table="IDENTIFIER"
            schema="FR"
            lazy="true"
            inverse="false"
            cascade="none"
            batch-size="100"
        >
            <key>
                <column name="RECORD_ID" />
            </key>
            <many-to-many 
                column="PERSON_ID"
                class="nz.cri.gns.fred.hibernate.Person"
            />
        </set>
        <!-- bi-directional many-to-one association to Stage -->
        <many-to-one
            name="stage"
            class="nz.cri.gns.fred.hibernate.Stage"
            not-null="true"
            cascade="all"
        >
            <column name="STAGE_ID" />
        </many-to-one>

    </class>
</hibernate-mapping>
