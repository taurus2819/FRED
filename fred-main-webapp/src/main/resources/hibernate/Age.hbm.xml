<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>

<class 
    name="nz.cri.gns.fred.hibernate.Age" 
    table="age"
    schema="fr"
>

    <id
        name="ageId"
        type="java.lang.Integer"
        column="age_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.age_seq</param>
        </generator>
    </id>

	    <property
    	    name="name"
        	type="java.lang.String"
        	column="name"
        	length="64"
	    />
	    <property
    	    name="code"
        	type="java.lang.String"
        	column="code"
        	length="16"
	    />
	    <property
    	    name="period"
        	type="java.lang.String"
        	column="period"
        	length="16"
	    />
	    <property
    	    name="baseAge"
        	type="java.lang.Double"
        	column="base_age"
	    />
	    <property
    	    name="topAge"
        	type="java.lang.Double"
        	column="top_age"
	    />
	    <property
    	    name="comments"
        	type="java.lang.String"
        	column="comments"
        	length="128"
	    />
	    <property
    	    name="obsoleteFlag"
        	type="java.lang.Integer"
        	column="obsolete_flag"
	    />
	    <property
    	    name="duplicateFlag"
        	type="java.lang.Integer"
        	column="duplicate_flag"
	    />
	       		   		   		
    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to Stage -->
    <set
        name="stagesByAgeLowerId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="age_lower_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Stage"
        />
    </set>

    <!-- bi-directional one-to-many association to Stage -->
    <set
        name="stagesByAgeUpperId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="age_upper_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Stage"
        />
    </set>
    
</class>
</hibernate-mapping>