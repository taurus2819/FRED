<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.MetaCatType" 
    table="TYPE"
    schema="METACAT"
    mutable="false"
>

    <id
        name="typeId"
        type="java.lang.Integer"
        column="TP_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="TP_DESCRIPTION"
        not-null="true"
        length="30"
    />
       
    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to MetaCat -->
    <set
        name="metaCats"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="TYPE_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.MetaCat"
        />
    </set>

</class>
</hibernate-mapping>