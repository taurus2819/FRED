<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.UserRightView" 
    table="USER_RIGHT_VIEW2"
    schema="IP"
    mutable="false"
>

    <id
        name="userId"
        type="int"
        column="PERSON_ID"
    >
        <generator class="sequence">
                <param name="sequence">USER_SEQ</param>
        </generator>
    </id>

	    <property
    	    name="givenName"
        	type="java.lang.String"
        	column="GIVEN_NAME"
        	length="50"
	    />
	    <property
    	    name="familyName"
        	type="java.lang.String"
        	column="FAMILY_NAME"
        	length="40"
	    />
	    <property
    	    name="fullName"
        	type="java.lang.String"
        	column="FULL_NAME"
        	length="91"
	    />
	    <property
    	    name="ipRightName"
        	type="java.lang.String"
        	column="ir_name"
            length="36"
	    />
   		   		   		
    <!-- Associations -->
  

    
    <!-- bi-directional many-to-one association to OrgView -->
    <many-to-one
        name="userView"
        class="nz.cri.gns.fred.hibernate.UserView"
        not-null="true"
        insert="false"
        update="false"
    >
        <column name="PERSON_ID" />
    </many-to-one>
    
</class>
</hibernate-mapping>
