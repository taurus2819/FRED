<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Folder" 
    table="folder"
    schema="fr"
>

    <id
        name="folderId"
        type="int"
        column="folder_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.folder_seq</param>
                <param name="increment_size">1</param>
        </generator>
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="name"
        not-null="true"
        length="32"
    />

    <!-- Associations -->
    <!-- bi-directional many-to-one association to FolderType -->
    <many-to-one
        name="folderType"
        class="nz.cri.gns.fred.hibernate.FolderType"
        not-null="true"
    >
        <column name="folder_type" />
    </many-to-one>

    <!-- bi-directional many-to-one association to FrUserView -->
    <many-to-one
        name="owner"
        class="nz.cri.gns.fred.hibernate.FrUserView"
        cascade="none"
    >
        <column name="owner_id" />
    </many-to-one>
      
    <!-- bi-directional one-to-many association to AuditTable -->
    <set
        name="audits"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="working_folder_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.AuditTable"
        />
    </set>
    <!-- bi-directional one-to-many association to Feature -->
    <set
        name="masterfileFeatures"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="masterfile_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>
    <!-- bi-directional many-to-many association to Feature via FolderContent -->
    <set
        name="features"
        table="folder_content"
		schema="fr"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="folder_id" />
        </key>
        <many-to-many 
			column="feature_id"
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>
    <!-- bi-directional one-to-many association to FolderUser -->
    <set
        name="folderUsers"
        lazy="true"
        inverse="true"
		cascade="all-delete-orphan"
    >
        <key>
            <column name="folder_id" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.FolderUser"
        />
    </set>

</class>
</hibernate-mapping>
