<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Adoption" 
    table="adoption"
    schema="fr"
>

    <id
        name="recordId"
        type="int"
        column="record_id"
    >
         <generator class="foreign">
            <param name="property">record</param>
        </generator>
    </id>

    <property
        name="adoptionDate"
        type="java.sql.Date"
        column="adoption_date"
        length="7"
    />
    <property
        name="dateRounding"
        type="java.lang.String"
        column="date_rounding"
        length="5"
    />
    <property
        name="comments"
        type="java.lang.String"
        column="comments"
        length="255"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-one association to Record -->
    <one-to-one
        name="record"
        class="nz.cri.gns.fred.hibernate.Record"
        outer-join="auto"
        constrained="true"
        cascade="all"
    />
    <!-- bi-directional many-to-many association to Person via Adoptor -->
    <set
        name="adoptors"
        table="adoptor"
		schema="fr"
        lazy="true"
        inverse="false"
		cascade="none"
    >
        <key>
            <column name="record_id" />
        </key>
        <many-to-many 
			column="person_id"
            class="nz.cri.gns.fred.hibernate.Person"
        />
    </set>
    <!-- bi-directional many-to-one association to Stage -->
    <many-to-one
        name="stage"
        class="nz.cri.gns.fred.hibernate.Stage"
        not-null="true"
    >
        <column name="adopted_stage_id" />
    </many-to-one>

</class>
</hibernate-mapping>
