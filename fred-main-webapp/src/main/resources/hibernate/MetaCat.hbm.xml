<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.MetaCat" 
    table="META_CAT"
    schema="metacat"
    mutable="false"
>

    <id
        name="metaId"
        type="java.lang.Integer"
        column="META_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="title"
        type="java.lang.String"
        column="TITLE"
        not-null="true"
        length="1000"
    />
    <property
        name="sizeKb"
        type="java.lang.Integer"
        column="SIZE_KB"
    />
    
    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to MetaCatType -->
    <many-to-one
        name="metaCatType"
        class="nz.cri.gns.fred.hibernate.MetaCatType"
        not-null="true"
    >
        <column name="TYPE_ID" />
    </many-to-one>

</class>
</hibernate-mapping>