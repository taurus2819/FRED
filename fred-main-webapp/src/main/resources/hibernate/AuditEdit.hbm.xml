<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.org/dtd/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.AuditEdit" 
    table="audit_edit"
    schema="fr"
>

    <id
        name="auditEditId"
        type="int"
        column="audit_edit_id"
    >
        <generator class="sequence">
                <param name="sequence">fr.audit_edit_seq</param>
        </generator>
   </id>

    <property
        name="editedById"
        type="java.lang.Integer"
        column="edited_by_id"
        length="7"
    />
    <property
        name="editedDate"
        type="java.sql.Date"
        column="edited_date"
        length="7"
    />
    <property
        name="comments"
        type="java.lang.String"
        column="comments"
        length="255"
    />

    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="audit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
    >
        <column name="audit_id" />
    </many-to-one>
    <!-- bi-directional many-to-one association to UserView -->
    <many-to-one
        name="editedBy"
        class="nz.cri.gns.fred.hibernate.UserView"
        not-null="false"
        insert="false"
        update="false"
    >
        <column name="edited_by_id" />
    </many-to-one>

</class>
</hibernate-mapping>
