<?xml version="1.0" encoding="ISO-8859-1"?>
<web-app version="2.5" 
         xmlns="http://java.sun.com/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <servlet>
        <servlet-name>frf</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.FRFormServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ajax</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.AJAXServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>locality</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.LocalityServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>wfsProxy</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.WFSProxy</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>dataEntryTemplate</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.DataEntryTemplateServlet</servlet-class>
    </servlet>        
    <servlet>
        <servlet-name>de.jsp</servlet-name>
        <servlet-class>nz.cri.gns.fred.servlet.De_jsp</servlet-class>
    </servlet>        
    
    <servlet-mapping>
        <servlet-name>ajax</servlet-name>
        <url-pattern>/ajaxSupport.xml</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>frf</servlet-name>
        <url-pattern>/frf/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>locality</servlet-name>
        <url-pattern>/locality/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>wfsProxy</servlet-name>
        <url-pattern>/wfsProxy</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>dataEntryTemplate</servlet-name>
        <url-pattern>/data-entry-template/*</url-pattern>
    </servlet-mapping>        
    <servlet-mapping>
        <servlet-name>de.jsp</servlet-name>
        <url-pattern>/de.jsp</url-pattern>
    </servlet-mapping>        

    <session-config>
        <session-timeout>240</session-timeout>
    </session-config>
    
    <env-entry> 
        <env-entry-name>WFS</env-entry-name> 
        <env-entry-value>http://maps.gns.cri.nz/geoserver/wfs</env-entry-value> 
        <env-entry-type>java.lang.String</env-entry-type> 
    </env-entry>
    
</web-app>
