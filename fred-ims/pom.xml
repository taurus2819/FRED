
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nz.cri.gns.fred</groupId>
        <artifactId>fred-top</artifactId>
        <version>2.2.21</version>
    </parent>
    <groupId>nz.cri.gns</groupId>
    <artifactId>fred-ims</artifactId>
    <packaging>jar</packaging>
    <version>2.2.21</version>
    <name>FRED ArcIMS</name>
    <url>http://fred.org.nz</url>  
    <organization>
        <name>GNS Science Ltd</name>
        <url>http://www.gns.cri.nz</url>
    </organization>
    <description>FRED ArcIMS Webapp</description>  
    <dependencies>
    </dependencies>
    <profiles>
        <profile>
            <id>env-local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-local</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>2.2.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/resources/assemblies/ims-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id> <!-- this is used for inheritance merges -->
                                <phase>package</phase> <!-- bind to the packaging phase -->
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-release-plugin</artifactId>
                        <version>2.3.2</version>
                        <configuration>
                            <tagNameFormat>RELEASE_@{project.version}</tagNameFormat>
                        </configuration>
                    </plugin>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-dev</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-dev</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>2.2.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/resources/assemblies/ims-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id> <!-- this is used for inheritance merges -->
                                <phase>package</phase> <!-- bind to the packaging phase -->
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>                    
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-test</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-test</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>2.2.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/resources/assemblies/ims-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id> <!-- this is used for inheritance merges -->
                                <phase>package</phase> <!-- bind to the packaging phase -->
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-prod</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-prod</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>2.2.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/resources/assemblies/ims-assembly.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id> <!-- this is used for inheritance merges -->
                                <phase>package</phase> <!-- bind to the packaging phase -->
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>versions-maven-plugin</artifactId>
                        <version>1.3.1</version>
                    </plugin>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
    </profiles>  
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>  
    <scm>
        <connection>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/tags/RELEASE_2.2.21/fred-ims</connection>
        <developerConnection>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/tags/RELEASE_2.2.21/fred-ims</developerConnection>
        <url>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/tags/RELEASE_2.2.21/fred-ims</url>
    </scm>
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>GNS Private Repository</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-releases-local</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>libs-snapshots</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-snapshots-local</url>
        </snapshotRepository>
    </distributionManagement>
</project>
