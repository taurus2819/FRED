<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nz.cri.gns</groupId>
    <artifactId>fred-ims</artifactId>
    <packaging>jar</packaging>
    <version>2.0.0-RELEASE</version>
    <name>Fossil Record Electronic Database</name>
    <url>http://fred.org.nz</url>  
    <organization>
        <name>GNS Science Ltd</name>
        <url>http://www.gns.cri.nz</url>
    </organization>
    <description>FRED ArcIMS Webapp</description>  
    <dependencies>
    <profiles>
        <profile>
            <id>env-local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-local</value>
                </property>
            </activation>
            <build>
                <plugins>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-dev</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-dev</value>
                </property>
            </activation>
            <build>
                <plugins>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-test</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-test</value>
                </property>
            </activation>
            <build>
                <plugins>
		</plugins>
		<finalName>fred-ims</finalName>
            </build>
        </profile>
        <profile>
            <id>env-prod</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>env</name>
                    <value>env-prod</value>
                </property>
            </activation>
            <build>
                <plugins>
                </plugins>
                <finalName>fred-ims</finalName>
            </build>
        </profile>
    </profiles>  
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>      
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>GNS Private Repository</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-releases-local</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>libs-snapshots</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-snapshots-local</url>
        </snapshotRepository>
    </distributionManagement>
</project>
