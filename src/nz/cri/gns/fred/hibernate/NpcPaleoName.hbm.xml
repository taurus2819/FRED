<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
     "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.NpcPaleoName" 
    table="PALEO_NAME"
    schema="NPC"
    mutable="false"
>

    <id
        name="nameId"
        type="java.lang.Integer"
        column="NAME_ID"
    >
         <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="NAME"
        length="64"
    />

    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to TaxonomicLookup -->
    <many-to-one
        name="taxon"
        class="nz.cri.gns.fred.hibernate.TaxonomicLookup"
        not-null="true"
    >
        <column name="TAXA_ID" />
    </many-to-one>

</class>
</hibernate-mapping>