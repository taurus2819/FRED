<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FolderUser" 
    table="FOLDER_USER"
    schema="FR"
>

    <id
        name="fuId"
        type="int"
        column="FU_ID"
    >
        <generator class="sequence">
                <param name="sequence">FR.FU_SEQ</param>
        </generator>
    </id>
    
    <property
        name="userRights"
        type="int"
        column="USER_RIGHTS"
        length="3"
    />

    <!-- Associations -->

    <!-- bi-directional many-to-one association to Folder -->
    <many-to-one
        name="folder"
	    class="nz.cri.gns.fred.hibernate.Folder"
	    not-null="true"
	>
    	<column name="FOLDER_ID" />
	</many-to-one>

    <many-to-one
        name="user"
        class="nz.cri.gns.fred.hibernate.FrUserView"
        not-null="true"
	>
    	<column name="USER_ID" />
	</many-to-one>
		
</class>
</hibernate-mapping>