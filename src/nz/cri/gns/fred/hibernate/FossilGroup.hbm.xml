<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FossilGroup" 
    table="FOSSIL_GROUP"
>

    <id
        name="groupId"
        type="int"
        column="GROUP_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="NAME"
        not-null="true"
        length="32"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to SentTo -->
    <set
        name="sentTos"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="FOSSIL_GROUP_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.SentTo"
        />
    </set>

</class>
</hibernate-mapping>
