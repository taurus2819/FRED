<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Record" 
    table="RECORD"
    schema="FR"
>

    <id
        name="recordId"
        type="int"
        column="RECORD_ID"
    >
        <generator class="sequence">
                <param name="sequence">FR.RECORD_SEQ</param>
        </generator>
    </id>

    <!-- Associations -->
  
    <!-- bi-directional one-to-one association to Paleontology -->
    <one-to-one
        name="paleontology"
		class="nz.cri.gns.fred.hibernate.Paleontology"
		cascade="all"
		outer-join="auto"
    />

    <!-- bi-directional one-to-one association to Adoption -->
    <one-to-one
        name="adoption"
        class="nz.cri.gns.fred.hibernate.Adoption"
        cascade="all"
		outer-join="auto"
    />
    <!-- bi-directional many-to-one association to Sample -->
    <many-to-one
        name="sample"
        class="nz.cri.gns.fred.hibernate.Sample"
        not-null="true"
    >
        <column name="SAMPLE_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="audit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
        cascade="all"
    >
        <column name="AUDIT_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="palListAudit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
        cascade="all"
    >
        <column name="PAL_LIST_AUDIT_ID" />
    </many-to-one>

    <!-- bi-directional many-to-many association to MetaCat -->
    <set
        name="metaCats"
        lazy="true"
		cascade="none"
        table="RECORD_META"
    >
        <key>
            <column name="RECORD_ID" />
        </key>
        <many-to-many
            class="nz.cri.gns.fred.hibernate.MetaCat"
        >
            <column name="META_ID" />
        </many-to-many>
    </set>

    <!-- bi-directional one-to-many association to RecordStageView -->
    <set
        name="recordStageViews"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column not-null="true" name="RECORD_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.RecordStageView"
        />
    </set>
    
</class>
</hibernate-mapping>
