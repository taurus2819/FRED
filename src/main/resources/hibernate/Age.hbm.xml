<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>

<class 
    name="nz.cri.gns.fred.hibernate.Age" 
    table="AGE"
    schema="FR"
    mutable="false"
>

    <id
        name="ageId"
        type="java.lang.Integer"
        column="AGE_ID"
    >
        <generator class="assigned" />
    </id>

	    <property
    	    name="name"
        	type="java.lang.String"
        	column="NAME"
        	length="64"
	    />
	    <property
    	    name="code"
        	type="java.lang.String"
        	column="CODE"
        	length="16"
	    />
	    <property
    	    name="period"
        	type="java.lang.String"
        	column="PERIOD"
        	length="16"
	    />
	    <property
    	    name="baseAge"
        	type="java.lang.Double"
        	column="BASE_AGE"
	    />
	    <property
    	    name="topAge"
        	type="java.lang.Double"
        	column="TOP_AGE"
	    />
	    <property
    	    name="comments"
        	type="java.lang.String"
        	column="COMMENTS"
        	length="128"
	    />
	    <property
    	    name="obsoleteFlag"
        	type="java.lang.Boolean"
        	column="OBSOLETE_FLAG"
	    />
	    <property
    	    name="duplicateFlag"
        	type="java.lang.Boolean"
        	column="DUPLICATE_FLAG"
	    />
	       		   		   		
    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to Stage -->
    <set
        name="stagesByAgeLowerId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="AGE_LOWER_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Stage"
        />
    </set>

    <!-- bi-directional one-to-many association to Stage -->
    <set
        name="stagesByAgeUpperId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="AGE_UPPER_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Stage"
        />
    </set>
    
</class>
</hibernate-mapping>