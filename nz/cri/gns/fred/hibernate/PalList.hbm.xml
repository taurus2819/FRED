<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.PalList" 
    table="PAL_LIST"
>

    <id
        name="palListId"
        type="int"
        column="PAL_LIST_ID"
    >
        <generator class="sequence">
                <param name="sequence">PAL_LIST_SEQ</param>
        </generator>
    </id>

    <property
        name="comments"
        type="java.lang.String"
        column="COMMENTS"
        length="255"
    />
    <property
        name="specimenCount"
        type="int"
        column="SPECIMEN_COUNT"
        length="5"
    />
    <property
        name="specimenCoords"
        type="java.lang.String"
        column="SPECIMEN_COORDS"
        length="64"
    />
    <property
        name="taxonomicName"
        type="java.lang.String"
        column="TAXONOMIC_NAME"
        length="128"
    />

    <!-- Associations -->
  
    <!-- bi-directional many-to-one association to TaxonomicGroup -->
    <many-to-one
        name="taxonomicGroup"
        class="nz.cri.gns.fred.hibernate.TaxonomicGroup"
        not-null="true"
    >
        <column name="GROUP_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to Paleontology -->
    <many-to-one
        name="paleontology"
        class="nz.cri.gns.fred.hibernate.Paleontology"
        not-null="true"
    >
        <column name="RECORD_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to TaxonomicLookup -->
    <many-to-one
        name="taxon"
        class="nz.cri.gns.fred.hibernate.TaxonomicLookup"
    >
        <column name="TAXA_ID" />
    </many-to-one>

</class>
</hibernate-mapping>
