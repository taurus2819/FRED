<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.SentTo" 
    table="SENT_TO"
>

    <composite-id name="comp_id" class="nz.cri.gns.fred.hibernate.SentToPK">
        <key-property 
            name="fossilGroupId" 
            column="FOSSIL_GROUP_ID" 
            type="int"
            length="3"
        />
        <key-property 
            name="sampleId" 
            column="SAMPLE_ID" 
            type="int"
            length="7"
        />
    </composite-id>    

    <property
        name="sentDate"
        type="java.sql.Date"
        column="SENT_DATE"
        length="7"
    />
    <property
        name="dateRounding"
        type="java.lang.String"
        column="DATE_ROUNDING"
        length="5"
    />
    <property
        name="labId"
        type="int"
        column="LAB_ID"
        length="4"
    />
    <property
        name="comments"
        type="java.lang.String"
        column="COMMENTS"
        length="255"
    />

    <!-- Associations -->
    <!-- derived association(s) for compound key -->
    <!-- bi-directional many-to-one association to Sample -->
    <many-to-one
        name="sample"
	    class="nz.cri.gns.fred.hibernate.Sample"
	    update="false"
	    insert="false"
	>
    	<column name="SAMPLE_ID" />
	</many-to-one>
	
    <!-- bi-directional many-to-one association to FossilGroup -->
    <many-to-one
        name="fossilGroup"
	    class="nz.cri.gns.fred.hibernate.FossilGroup"
	    update="false"
	    insert="false"
	>
    	<column name="FOSSIL_GROUP_ID" />
	</many-to-one>
	
    <!-- end of derived association(s) -->
  
    <!-- bi-directional many-to-one association to Person -->
    <many-to-one
        name="person"
        class="nz.cri.gns.fred.hibernate.Person"
        not-null="true"
    >
        <column name="PERSON_ID" />
    </many-to-one>

</class>
</hibernate-mapping>
