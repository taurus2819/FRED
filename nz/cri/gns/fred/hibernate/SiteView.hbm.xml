<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.SiteView" 
    table="SC.SITE_VIEW"
    mutable="false"
>

    <id
        name="siteId"
        type="int"
        column="SITE_ID"
    >
        <generator class="sequence">
                <param name="sequence">SC.SITE_SEQ</param>
        </generator>
    </id>

	    <property
    	    name="siteName"
        	type="java.lang.String"
        	column="SITE_NAME"
        	length="64"
	    />
	    <property
    	    name="latitude"
        	type="double"
        	column="LATITUDE"
	    />
	    <property
    	    name="longitude"
        	type="double"
        	column="LONGITUDE"
	    />
	    <property
    	    name="countryCode"
        	type="java.lang.String"
        	column="COUNTRY_CODE"
    	    length="2"
	    />
	    <property
    	    name="countryName"
        	type="java.lang.String"
	        column="COUNTRY_NAME"
    	    length="25"
   		/>
	    <property
    	    name="nzmgSheet"
        	type="java.lang.String"
	        column="NZMG_SHEET"
    	    length="3"
   		/>
	    <property
    	    name="nzmgEast"
        	type="double"
	        column="NZMG_EAST"
   		/>   		
	    <property
    	    name="nzmgNorth"
        	type="double"
	        column="NZMG_NORTH"
   		/>
	    <property
    	    name="qmapSheet"
        	type="java.lang.String"
	        column="QMAP_SHEET"
    	    length="16"
   		/>
	    <property
    	    name="nzms262Sheet"
        	type="java.lang.String"
	        column="NZMS262_SHEET"
    	    length="16"
   		/>
	    <property
    	    name="island"
        	type="java.lang.String"
	        column="ISLAND"
    	    length="64"
   		/>
	    <property
    	    name="methodId"
        	type="int"
	        column="METHOD_ID"
   		/>
	    <property
    	    name="method"
        	type="java.lang.String"
	        column="METHOD"
    	    length="64"
   		/>
	    <property
    	    name="accuracy"
        	type="double"
	        column="ACCURACY"
   		/>
	    <property
    	    name="directions"
        	type="java.lang.String"
	        column="DIRECTIONS"
    	    length="1000"
   		/>
	    <property
    	    name="origSystemId"
        	type="int"
	        column="ORIG_SYSTEM_ID"
   		/>
	    <property
    	    name="coordSystem"
        	type="java.lang.String"
	        column="COORD_SYSTEM"
    	    length="64"
   		/>
	    <property
    	    name="origCoord"
        	type="java.lang.String"
	        column="ORIG_COORD"
    	    length="32"
   		/>
	    <property
    	    name="height"
        	type="double"
	        column="HEIGHT"
   		/>
	    <property
    	    name="horizMethodId"
        	type="int"
	        column="H_METHOD_ID"
   		/>
	    <property
    	    name="horizMethod"
        	type="java.lang.String"
	        column="H_METHOD"
    	    length="64"
   		/>
	    <property
    	    name="horizAccuracy"
        	type="double"
	        column="H_ACCURACY"
   		/>
	    <property
    	    name="ownerId"
        	type="int"
	        column="OWNER_ID"
   		/>
	    <property
    	    name="owner"
        	type="java.lang.String"
	        column="OWNER"
    	    length="91"
   		/>
   		   		   		
    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to Feature -->
    <set
        name="features"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="SITE_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.Feature"
        />
    </set>

</class>
</hibernate-mapping>
