<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.FrUserView" 
    table="FR_USER_VIEW"
    mutable="false"
>

    <id
        name="userId"
        type="int"
        column="PE_ID"
    >
        <generator class="sequence">
                <param name="sequence">USER_SEQ</param>
        </generator>
    </id>

	    <property
    	    name="userName"
        	type="java.lang.String"
        	column="GRANTEE"
        	length="30"
	    />
	    <property
    	    name="givenName"
        	type="java.lang.String"
        	column="GIVEN_NAME"
        	length="50"
	    />
	    <property
    	    name="familyName"
        	type="java.lang.String"
        	column="FAMILY_NAME"
        	length="40"
	    />
	    <property
    	    name="fullName"
        	type="java.lang.String"
        	column="FULL_NAME"
        	length="91"
	    />
   		   		   		
    <!-- Associations -->
  
    <!-- bi-directional many-to-many association to TaxonomicGroup via TaxaPanel -->
    <set
        name="taxonomicGroups"
        table="TAXA_PANEL"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="PANELIST_ID" />
        </key>
        <many-to-many 
			column="GROUP_ID"
            class="nz.cri.gns.fred.hibernate.TaxonomicGroup"
        />
    </set>
    
</class>
</hibernate-mapping>
