<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.TaxonomicGroup" 
    table="TAXONOMIC_GROUP"
>

    <id
        name="groupId"
        type="int"
        column="GROUP_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="NAME"
        not-null="true"
        length="32"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to PalList -->
    <set
        name="palLists"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="GROUP_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.PalList"
        />
    </set>
        <!-- bi-directional many-to-many association to FrUserView via TaxaPanel -->
    <set
        name="panelists"
        table="TAXA_PANEL"
        lazy="true"
        inverse="false"
		cascade="none"
    >
        <key>
            <column name="GROUP_ID" />
        </key>
        <many-to-many 
			column="PANELIST_ID"
            class="nz.cri.gns.fred.hibernate.FrUserView"
        />
    </set>
    
    
    
    
    <!-- bi-directional one-to-many association to TaxaPanel 
    <set
        name="taxaPanelists"
        lazy="true"
        inverse="true"
		cascade="all-delete-orphan"
    >
        <key>
            <column name="GROUP_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.TaxaPanelist"
        />
    </set> -->
    <!-- bi-directional one-to-many association to TaxonomicLookup -->
    <set
        name="taxonomicLookups"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="GROUP_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.TaxonomicLookup"
        />
    </set>

</class>
</hibernate-mapping>
