<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.DataOrigin" 
    table="DATA_ORIGIN"
>

    <id
        name="originId"
        type="int"
        column="ORIGIN_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="NAME"
        not-null="true"
        length="32"
    />
    <property
        name="description"
        type="java.lang.String"
        column="DESCRIPTION"
        length="255"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to AuditTable -->
    <set
        name="auditTablesByDataHistoryId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="DATA_HISTORY_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.AuditTable"
        />
    </set>
    <!-- bi-directional one-to-many association to AuditTable -->
    <set
        name="auditTablesByDataOriginId"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="DATA_ORIGIN_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.AuditTable"
        />
    </set>

</class>
</hibernate-mapping>
