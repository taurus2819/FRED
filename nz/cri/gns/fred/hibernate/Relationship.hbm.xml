<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Relationship" 
    table="RELATIONSHIP"
>

    <id
        name="relationshipId"
        type="int"
        column="RELATIONSHIP_ID"
    >
        <generator class="sequence">
                <param name="sequence">RELATIONSHIP_SEQ</param>
        </generator>
    </id>

    <property
        name="stratUnitId"
        type="int"
        column="STRAT_UNIT_ID"
        length="5"
    />
    <property
        name="stratUnit"
        type="java.lang.String"
        column="STRAT_UNIT"
        length="255"
    />
    <property
        name="distance"
        type="double"
        column="DISTANCE"
        length="7"
    />
    <property
        name="distanceMod"
        type="java.lang.String"
        column="DISTANCE_MOD"
        length="2"
    />
    <property
        name="distanceRange"
        type="double"
        column="DISTANCE_RANGE"
        length="8"
    />

    <!-- Associations -->
  
   <!-- bi-directional many-to-one association to RelationType -->
    <many-to-one
        name="relationType"
        class="nz.cri.gns.fred.hibernate.RelationType"
        not-null="true"
    >
        <column name="RELATIONSHIP_TYPE" />
    </many-to-one>

    <!-- bi-directional many-to-one association to Sample -->
    <many-to-one
        name="sample"
		class="nz.cri.gns.fred.hibernate.Sample"
        not-null="true"
    >
        <column name="SAMPLE_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to Feature -->
    <many-to-one
        name="feature"
        class="nz.cri.gns.fred.hibernate.Feature"
        not-null="true"
        cascade="none"
    >
        <column name="RELATED_FEATURE_ID" />
    </many-to-one>

    <!-- bi-directional many-to-one association to RelationshipType -->
    <many-to-one
        name="relationshipType"
        class="nz.cri.gns.fred.hibernate.RelationshipType"
        not-null="true"
    >
        <column name="RELATION_TYPE_ID" />
    </many-to-one>

</class>
</hibernate-mapping>
