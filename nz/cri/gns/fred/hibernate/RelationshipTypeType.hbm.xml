<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.RelationshipTypeType" 
    table="RELATIONSHIP_TYPE_TYPE"
>

    <id
        name="typeId"
        type="int"
        column="TYPE_ID"
    >
        <generator class="assigned" />
    </id>

    <property
        name="name"
        type="java.lang.String"
        column="NAME"
        not-null="true"
        length="32"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-many association to RelationshipType -->
    <set
        name="relationshipTypes"
        lazy="true"
        inverse="true"
		cascade="none"
    >
        <key>
            <column name="RELTYPE_TYPE" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.RelationshipType"
        />
    </set>

</class>
</hibernate-mapping>
