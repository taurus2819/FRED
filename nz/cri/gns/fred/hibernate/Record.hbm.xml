<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.1

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="nz.cri.gns.fred.hibernate.Record" 
    table="RECORD"
>

    <id
        name="recordId"
        type="int"
        column="RECORD_ID"
    >
        <generator class="sequence">
                <param name="sequence">RECORD_SEQ</param>
        </generator>
    </id>

    <property
        name="workingComments"
        type="java.lang.String"
        column="WORKING_COMMENTS"
        length="255"
    />

    <!-- Associations -->
  
    <!-- bi-directional one-to-one association to Paleontology -->
    <one-to-one
        name="paleontology"
		class="nz.cri.gns.fred.hibernate.Paleontology"
        outer-join="auto"
    />
    <!-- bi-directional one-to-many association to RecordMeta -->
    <set
        name="recordMetas"
        lazy="true"
		cascade="none"
    >
        <key>
            <column name="RECORD_ID" />
        </key>
        <one-to-many 
            class="nz.cri.gns.fred.hibernate.RecordMeta"
        />
    </set>
    <!-- bi-directional one-to-one association to Adoption -->
    <one-to-one
        name="adoption"
        class="nz.cri.gns.fred.hibernate.Adoption"
        outer-join="auto"
    />
    <!-- bi-directional many-to-one association to Sample -->
    <many-to-one
        name="sample"
        class="nz.cri.gns.fred.hibernate.Sample"
        not-null="true"
    >
        <column name="SAMPLE_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to Folder -->
    <many-to-one
        name="folder"
        class="nz.cri.gns.fred.hibernate.Folder"
        not-null="true"
    >
        <column name="WORKING_FOLDER_ID" />
    </many-to-one>
    <!-- bi-directional many-to-one association to AuditTable -->
    <many-to-one
        name="audit"
        class="nz.cri.gns.fred.hibernate.AuditTable"
        not-null="true"
    >
        <column name="AUDIT_ID" />
    </many-to-one>


</class>
</hibernate-mapping>
