<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>nz.cri.gns.fred</groupId>
    <artifactId>fred-top</artifactId>
    <version>2.2.39-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Fossil Record Electronic Database</name>
    <url>http://fred.org.nz</url>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <source>1.6</source>
                    <target>1.6</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <tagNameFormat>RELEASE_@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>1.3.1</version>
            </plugin>
        </plugins>
        <finalName>fred</finalName>
    </build>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <modules>
        <module>fred-main-webapp</module>
        <module>fred-redirect-webapp</module>
        <module>fred-ims</module>
    </modules>
    <scm>
        <connection>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/trunk</connection>
        <developerConnection>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/trunk</developerConnection>
        <url>scm:svn:svn+ssh://jenkins@repo/repo/applications/FRED/trunk</url>
    </scm>
    <distributionManagement>
        <repository>
            <id>central</id>
            <name>GNS Private Repository</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-releases-local</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>libs-snapshots</name>
            <url>http://repo.gns.cri.nz/artifactory/libs-snapshots-local</url>
        </snapshotRepository>
    </distributionManagement>
</project> 
